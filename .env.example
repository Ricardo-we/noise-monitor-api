# Conexión a Neon (PostgreSQL). Usada por Prisma CLI y por la API.
# El host "-pooler" es el connection pooler de Neon (recomendado para la API).
# El host sin "-pooler" se usa para migraciones.
DB_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Puerto y host del servidor HTTP
PORT=3000
HOST=0.0.0.0

# development | production | test
NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma. "*" permite cualquiera.
CORS_ORIGIN="*"

# Día calendario usado para la regla de 50 metros (HU-08).
MEASUREMENT_TIME_ZONE="America/Guatemala"
